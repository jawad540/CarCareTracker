@model CarCareTracker.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="auth-card">
    <div class="logo-circle">🚗</div>
    <h2>Car Care Tracker</h2>
    <p class="subtitle">Vehicle Expense and Maintenance Management System</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
        @*  AntiForgeryToken removed  *@
        @Html.ValidationSummary(true)

        <div class="form-group">
            <label>Email Address</label>
            <div class="input-icon">
                <span class="ic">✉️</span>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email", type = "email" })
            </div>
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
        </div>

        <div class="form-group">
            <label>Password</label>
            <div class="input-icon">
                <span class="ic">🔒</span>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
            </div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
        </div>

        <div class="auth-meta">
            <label class="form-check">@Html.CheckBoxFor(m => m.RememberMe) Remember me</label>
            <a href="#" class="text-link">Forgot Password?</a>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Login</button>

        <div class="auth-footer">
            Don't have an account? @Html.ActionLink("Create new account", "Register", "Account")
        </div>
    }
</div>
