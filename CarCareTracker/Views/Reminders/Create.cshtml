@model CarCareTracker.Models.Reminder
@{
    ViewBag.Title = "Create Reminder";
    ViewBag.ActiveNav = "reminders";
    var vehicles = ViewBag.Vehicles as System.Collections.Generic.List<CarCareTracker.Models.Vehicle>;
    var services = ViewBag.ServiceTypes as System.Collections.Generic.List<CarCareTracker.Models.ServiceType>;
}
<div class="page-head"><h1>Create Reminder</h1><p>Set a reminder for an upcoming service.</p></div>
<div class="card" style="max-width:640px;">
    <div class="card-head"><h3>Reminder Details</h3></div>
    <div class="card-body">
        @using (Html.BeginForm("Create", "Reminders", FormMethod.Post))
        {
            @*  AntiForgeryToken removed  *@
            @Html.ValidationSummary(true)
            <div class="form-group">
                <label>Select Vehicle *</label>
                <select name="VehicleId" class="form-control" required>
                    <option value="">Choose a vehicle</option>
                    @if (vehicles != null) { foreach (var v in vehicles) { <option value="@v.VehicleId">@v.Brand @v.Model (@v.PlateNumber)</option> } }
                </select>
            </div>
            <div class="form-group">
                <label>Reminder Title *</label>
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g., Oil Change Due" })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "field-error" })
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Service Type</label>
                    <select name="ServiceTypeId" class="form-control">
                        <option value="">None</option>
                        @if (services != null) { foreach (var s in services) { <option value="@s.ServiceTypeId">@s.ServiceName</option> } }
                    </select>
                </div>
                <div class="form-group">
                    <label>Reminder Date *</label>
                    @Html.TextBoxFor(m => m.ReminderDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
            </div>
            <div class="form-group">
                <label>Notes</label>
                @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", placeholder = "Additional notes (optional)" })
            </div>
            <div style="display:flex;gap:12px;">
                <button type="submit" class="btn btn-primary">Create Reminder</button>
                <a href="@Url.Action("Index")" class="btn btn-light">Cancel</a>
            </div>
        }
    </div>
</div>
