@model System.Collections.Generic.List<CarCareTracker.Models.MaintenanceRecord>
@{
    ViewBag.Title = "Maintenance";
    ViewBag.ActiveNav = "maintenance";
}
<div class="page-head page-head-row">
    <div><h1>Maintenance Records</h1><p>All maintenance and service history.</p></div>
    <a href="@Url.Action("Create")" class="btn btn-primary">+ Add Maintenance</a>
</div>
<div class="card"><div class="card-body" style="padding:0;">
    <div class="table-wrap">
        <table class="data">
            <thead><tr><th>Vehicle</th><th>Service</th><th>Date</th><th>Cost</th><th>Odometer</th><th>Provider</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="7" class="empty"><div class="ei">🔧</div>No maintenance records yet.</td></tr> }
            else { foreach (var m in Model) {
                <tr>
                    <td>@m.VehicleLabel</td>
                    <td><span class="badge badge-blue">@m.ServiceName</span></td>
                    <td>@m.MaintenanceDate.ToString("MMM dd, yyyy")</td>
                    <td><strong>$@m.Cost.ToString("N2")</strong></td>
                    <td>@(m.OdometerReading.HasValue ? m.OdometerReading.Value.ToString("N0") + " KM" : "-")</td>
                    <td>@(m.GarageName ?? "-")</td>
                    <td>
                        @using (Html.BeginForm("Delete", "Maintenance", new { id = m.MaintenanceId }, FormMethod.Post, new { onsubmit = "return confirm('Delete?');" }))
                        { @*  AntiForgeryToken removed  *@ <button type="submit" class="act-del">Delete</button> }
                    </td>
                </tr>
            } }
            </tbody>
        </table>
    </div>
</div></div>
