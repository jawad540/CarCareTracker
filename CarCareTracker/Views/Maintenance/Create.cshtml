@model CarCareTracker.Models.MaintenanceRecord
@{
    ViewBag.Title = "Add Maintenance Record";
    ViewBag.ActiveNav = "maintenance";
    var vehicles = ViewBag.Vehicles as System.Collections.Generic.List<CarCareTracker.Models.Vehicle>;
    var services = ViewBag.ServiceTypes as System.Collections.Generic.List<CarCareTracker.Models.ServiceType>;
}
<div class="page-head"><h1>Add Maintenance Record</h1><p>Record a maintenance or service performed on your vehicle.</p></div>

<div class="grid-2">
    <div class="card">
        <div class="card-head"><h3>Maintenance Details</h3></div>
        <div class="card-body">
            @using (Html.BeginForm("Create", "Maintenance", FormMethod.Post))
            {
                @*  AntiForgeryToken removed  *@
                @Html.ValidationSummary(true)
                <div class="form-group">
                    <label>Select Vehicle *</label>
                    <select name="VehicleId" class="form-control" required>
                        <option value="">Choose a vehicle</option>
                        @if (vehicles != null) { foreach (var v in vehicles) { <option value="@v.VehicleId">@v.Brand @v.Model (@v.PlateNumber)</option> } }
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Service Type *</label>
                        <select name="ServiceTypeId" class="form-control" required>
                            <option value="">Select service</option>
                            @if (services != null) { foreach (var s in services) { <option value="@s.ServiceTypeId">@s.ServiceName</option> } }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Maintenance Date *</label>
                        @Html.TextBoxFor(m => m.MaintenanceDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Cost ($) *</label>
                        @Html.TextBoxFor(m => m.Cost, new { @class = "form-control", type = "number", step = "0.01", placeholder = "e.g., 62.50" })
                    </div>
                    <div class="form-group">
                        <label>Odometer Reading (KM)</label>
                        @Html.TextBoxFor(m => m.OdometerReading, new { @class = "form-control", type = "number", placeholder = "e.g., 40250" })
                    </div>
                </div>
                <div class="form-group">
                    <label>Service Provider</label>
                    @Html.TextBoxFor(m => m.GarageName, new { @class = "form-control", placeholder = "e.g., AutoCare Center" })
                </div>
                <div class="form-group">
                    <label>Description</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "What was done during this service?" })
                </div>
                <div style="display:flex;gap:12px;">
                    <button type="submit" class="btn btn-primary">Save Maintenance</button>
                    <a href="@Url.Action("Index")" class="btn btn-light">Cancel</a>
                </div>
            }
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-head"><h3>🔧 Recommended Services</h3></div>
            <div class="card-body" style="font-size:13px;">
                <div class="activity-item"><div class="activity-ic stat-icon blue">🛢️</div><div><strong>Oil Change</strong><div class="meta">Every 5,000 - 10,000 KM</div></div></div>
                <div class="activity-item"><div class="activity-ic stat-icon green">🔄</div><div><strong>Tire Rotation</strong><div class="meta">Every 10,000 KM</div></div></div>
                <div class="activity-item"><div class="activity-ic stat-icon orange">💨</div><div><strong>Air Filter</strong><div class="meta">Every 15,000 - 30,000 KM</div></div></div>
                <div class="activity-item"><div class="activity-ic stat-icon red">🛑</div><div><strong>Brake Inspection</strong><div class="meta">Every 20,000 KM</div></div></div>
            </div>
        </div>
    </div>
</div>
