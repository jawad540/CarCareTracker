@model CarCareTracker.Models.ViewModels.ReportsViewModel
@{
    ViewBag.Title = "Reports";
    ViewBag.ActiveNav = "reports";
    decimal totalAll = Model.TotalFuelCost + Model.TotalMaintenanceCost;
    int fuelPct = totalAll > 0 ? (int)System.Math.Round(Model.TotalFuelCost / totalAll * 100) : 0;
    int maintPct = totalAll > 0 ? 100 - fuelPct : 0;
}
<div class="page-head"><h1>Reports and Analytics</h1><p>Analyze your vehicle expenses and trends.</p></div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-top"><div class="stat-icon blue">⛽</div></div>
        <div class="stat-label">Total Fuel Cost</div>
        <div class="stat-value">$@Model.TotalFuelCost.ToString("N2")</div>
        <div class="stat-sub">All time</div>
    </div>
    <div class="stat-card">
        <div class="stat-top"><div class="stat-icon orange">🔧</div></div>
        <div class="stat-label">Maintenance Cost</div>
        <div class="stat-value">$@Model.TotalMaintenanceCost.ToString("N2")</div>
        <div class="stat-sub">All time</div>
    </div>
    <div class="stat-card">
        <div class="stat-top"><div class="stat-icon green">📄</div></div>
        <div class="stat-label">Total Records</div>
        <div class="stat-value">@Model.TotalRecords</div>
        <div class="stat-sub">Fuel + Maintenance</div>
    </div>
    <div class="stat-card">
        <div class="stat-top"><div class="stat-icon purple">📈</div></div>
        <div class="stat-label">Average Monthly</div>
        <div class="stat-value">$@Model.AverageMonthly.ToString("N2")</div>
        <div class="stat-sub">Last 6 months</div>
    </div>
</div>

<div class="card">
    <div class="card-head"><h3>⚙️ Fuel Efficiency (Strategy Pattern)</h3></div>
    <div class="card-body">
        <p style="font-size:18px;font-weight:700;color:var(--primary);">@Model.FuelEfficiency</p>
        <p style="font-size:12px;color:var(--slate-500);">Calculated using the Strategy design pattern — the algorithm (km/L or L/100km) can be swapped at runtime.</p>
    </div>
</div>

<div class="grid-2-equal">
    <div class="card">
        <div class="card-head"><h3>Expense Overview</h3></div>
        <div class="card-body">
            <div class="legend">
                <span><span class="sq" style="background:var(--primary)"></span> Fuel Expenses</span>
                <span><span class="sq" style="background:var(--orange)"></span> Maintenance Cost</span>
            </div>
            <canvas id="overviewChart" height="160"></canvas>
        </div>
    </div>
    <div class="card">
        <div class="card-head"><h3>Expense Distribution</h3></div>
        <div class="card-body" style="display:flex;align-items:center;justify-content:center;gap:30px;">
            <canvas id="pieChart" width="180" height="180" style="max-width:180px;"></canvas>
            <div>
                <div style="margin-bottom:14px;"><span class="badge badge-blue">@fuelPct%</span> Fuel Expenses $@Model.TotalFuelCost.ToString("N2")</div>
                <div><span class="badge badge-orange">@maintPct%</span> Maintenance $@Model.TotalMaintenanceCost.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head"><h3>Expense Breakdown by Vehicle</h3></div>
    <div class="card-body" style="padding:0;">
        <div class="table-wrap">
            <table class="data">
                <thead><tr><th>Vehicle</th><th>Fuel Cost</th><th>Maintenance Cost</th><th>Total Expense</th><th>Records</th><th>Last Activity</th></tr></thead>
                <tbody>
                @if (Model.Breakdown.Count == 0) { <tr><td colspan="6" class="empty">No data to display.</td></tr> }
                else { foreach (var row in Model.Breakdown) {
                    <tr>
                        <td><strong>@row.VehicleLabel</strong></td>
                        <td>$@row.FuelCost.ToString("N2")</td>
                        <td>$@row.MaintenanceCost.ToString("N2")</td>
                        <td><strong>$@row.TotalExpense.ToString("N2")</strong></td>
                        <td>@row.Records</td>
                        <td>@(row.LastActivity.HasValue ? row.LastActivity.Value.ToString("MMM dd, yyyy") : "-")</td>
                    </tr>
                } }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
<script>
    new Chart(document.getElementById('overviewChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartMonths)),
            datasets: [
                { label: 'Fuel', data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartFuel)), backgroundColor: '#2563EB', borderRadius: 6 },
                { label: 'Maintenance', data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ChartMaintenance)), backgroundColor: '#EA580C', borderRadius: 6 }
            ]
        },
        options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
    new Chart(document.getElementById('pieChart'), {
        type: 'doughnut',
        data: {
            labels: ['Fuel','Maintenance'],
            datasets: [{ data: [@Model.TotalFuelCost, @Model.TotalMaintenanceCost], backgroundColor: ['#2563EB','#EA580C'] }]
        },
        options: { responsive: false, plugins: { legend: { display: false } } }
    });
</script>
}
