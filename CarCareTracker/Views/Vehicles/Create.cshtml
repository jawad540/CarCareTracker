@model CarCareTracker.Models.Vehicle
@{
    ViewBag.Title = "Add Vehicle";
    ViewBag.ActiveNav = "vehicles";
    var types = ViewBag.VehicleTypes as System.Collections.Generic.List<CarCareTracker.Models.VehicleType>;
}

<div class="page-head"><h1>Add New Vehicle</h1><p>Enter the details of your vehicle below.</p></div>

<div class="card">
    <div class="card-head"><h3>Vehicle Information</h3></div>
    <div class="card-body">
        @using (Html.BeginForm("Create", "Vehicles", FormMethod.Post))
        {
            @*  AntiForgeryToken removed  *@
            @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
            <div class="form-row">
                <div class="form-group">
                    <label>Plate Number *</label>
                    @Html.TextBoxFor(m => m.PlateNumber, new { @class = "form-control", placeholder = "e.g., ABC-123" })
                    @Html.ValidationMessageFor(m => m.PlateNumber, "", new { @class = "field-error" })
                </div>
                <div class="form-group">
                    <label>Brand *</label>
                    @Html.TextBoxFor(m => m.Brand, new { @class = "form-control", placeholder = "e.g., Toyota" })
                    @Html.ValidationMessageFor(m => m.Brand, "", new { @class = "field-error" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Model *</label>
                    @Html.TextBoxFor(m => m.Model, new { @class = "form-control", placeholder = "e.g., Corolla" })
                </div>
                <div class="form-group">
                    <label>Year *</label>
                    @Html.TextBoxFor(m => m.YearMade, new { @class = "form-control", type = "number", placeholder = "e.g., 2020" })
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Vehicle Type *</label>
                    <select name="TypeId" class="form-control">
                        <option value="">Select type</option>
                        @if (types != null)
                        {
                            foreach (var t in types)
                            {
                                <option value="@t.TypeId">@t.TypeName</option>
}
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Color</label>
                    @Html.TextBoxFor(m => m.Color, new { @class = "form-control", placeholder = "e.g., White" })
                </div>
            </div>
            <div class="form-group">
                <label>Current Odometer (KM)</label>
                @Html.TextBoxFor(m => m.CurrentOdometer, new { @class = "form-control", type = "number", placeholder = "e.g., 45000" })
            </div>
            <div style="display:flex;gap:12px;margin-top:8px;">
                <button type="submit" class="btn btn-primary">Save Vehicle</button>
                <a href="@Url.Action("Index")" class="btn btn-light">Cancel</a>
            </div>
        }
    </div>
</div>
